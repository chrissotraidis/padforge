{
  "schema_version": 1,
  "id": "bluewake",
  "repo_url": "https://github.com/chrissotraidis/bluewake",
  "name": "BlueWake",
  "player_targets": [
    "ios"
  ],
  "game_ids": [
    "GZLE01"
  ],
  "free_space_gb": 25,
  "player_help": "https://github.com/chrissotraidis/bluewake#getting-started",
  "reviewed_revision": null,
  "notes": "Interim manifest until BlueWake carries padmint.json. No revision is marked reviewed for players yet; pass --revision explicitly.",
  "manifest": {
    "schema_version": 1,
    "id": "bluewake",
    "name": "BlueWake",
    "game": "The Legend of Zelda: The Wind Waker (GameCube, GZLE01)",
    "kind": "disc-translation",
    "status": "experimental",
    "inputs": [
      {
        "type": "gamecube-disc",
        "formats": [
          "iso"
        ],
        "description": "Your own GZLE01 disc image; the backend verifies it."
      }
    ],
    "targets": {
      "ios": {
        "hosts": {
          "macos-arm64": "experimental",
          "linux-x86_64": "planned",
          "windows-x86_64": "planned"
        },
        "command": [
          "/bin/bash",
          "{repo}/scripts/builder/build.sh",
          "{disc}",
          "--out",
          "{work}",
          "--jobs",
          "{jobs}"
        ],
        "modes": {
          "full": [
            "--train-pgo",
            "--ipa",
            "{output}"
          ],
          "source-only": [
            "--source-only"
          ]
        },
        "options": {
          "no-mods": [
            "--no-mods"
          ]
        },
        "output": "ipa",
        "check": "bluewake-ipa"
      },
      "macos": {
        "hosts": {
          "macos-arm64": "planned"
        }
      }
    },
    "requirements": {
      "disk_gb": 25,
      "tools": [
        {
          "name": "git",
          "version_args": [
            "--version"
          ]
        },
        {
          "name": "cmake",
          "version_args": [
            "--version"
          ]
        },
        {
          "name": "ninja",
          "version_args": [
            "--version"
          ]
        },
        {
          "name": "python3",
          "version_args": [
            "--version"
          ]
        },
        {
          "name": "xcodebuild",
          "version_args": [
            "-version"
          ],
          "note": "Install Xcode and its iOS platform"
        }
      ]
    },
    "stages": [
      "preflight",
      "dependencies",
      "extract",
      "translate",
      "generate",
      "mods",
      "train-build",
      "train-run",
      "train-merge",
      "compile",
      "app",
      "package"
    ],
    "publication": {
      "public_binaries": false,
      "reason": "Personal builds contain translated game code; public releases are source only."
    }
  }
}
